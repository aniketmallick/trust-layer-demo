# Variable NAMES only. The real file is experiments/knife_handover/.env (git-ignored); the operator creates it.
# The judge reads the file itself; nothing else opens it. Check which names are set (never a value):
#   ~/lerobot-mps-venv/bin/python -m judge.env        (run from experiments/knife_handover)

# anthropic | openai
JUDGE_PROVIDER=
# optional. Unset: the provider's models are listed once at start and one is chosen by the rule in judge/providers.py
JUDGE_MODEL=
# the key matching JUDGE_PROVIDER (only that one is needed)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
